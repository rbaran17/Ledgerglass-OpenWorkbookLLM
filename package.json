{
  "name": "@ledgerglass/workbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Excel-style workbook for the browser: embeddable React component with formulas, XLSX import/export, an LLM assistant protocol, MCP, AG-UI and A2UI",
  "keywords": [
    "spreadsheet",
    "excel",
    "workbook",
    "react",
    "formulas",
    "xlsx",
    "llm",
    "mcp",
    "ag-ui",
    "a2ui",
    "audit"
  ],
  "homepage": "https://github.com/rbaran17/Ledgerglass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbaran17/Ledgerglass.git"
  },
  "bugs": {
    "url": "https://github.com/rbaran17/Ledgerglass/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.node.config.ts",
    "test": "npm run test:deployment && npm run test:unit",
    "test:unit": "vitest run",
    "test:types": "tsc -p types/tsconfig.json && node scripts/build-api-index.mjs --check",
    "docs:api": "node scripts/build-api-index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:lib": "node scripts/verify-lib.mjs && node scripts/verify-node.mjs",
    "test:agent-ui": "npm run build:lib && npm ci --prefix tests/agent-ui-host --ignore-scripts --no-audit --no-fund && node scripts/verify-agent-ui.mjs",
    "start": "node scripts/serve.mjs",
    "build:portable": "npm run build && node scripts/portable.mjs",
    "format": "prettier --write src tests scripts *.ts",
    "mcp": "node scripts/mcp-stdio.mjs",
    "build:container": "npm run build -- --outDir dist-container && node deploy/prepare-assets.mjs dist-container",
    "start:container": "node deploy/server.mjs",
    "test:deployment": "node --test deploy/tests/*.test.mjs",
    "test:containers": "node deploy/verify-containers.mjs",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.33",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "exceljs": "4.4.0",
    "fast-formula-parser": "1.0.19",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.70.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "13.5.0",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/ledgerglass.js"
    },
    "./style.css": "./lib/ledgerglass.css",
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./lib/node.js"
    },
    "./calculation-node": {
      "types": "./types/node.d.ts",
      "import": "./lib/node.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "import": "./src/mcp/server.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "docs/*.md",
    "docs/api/*.md",
    "lib",
    "types",
    "scripts/mcp-stdio.mjs",
    "src/mcp",
    "src/app"
  ],
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.22"
    }
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
